{
  "expo": {
    "name": "Ny Herin'ny Boky",
    "slug": "ny-herin-ny-boky",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f6efdd",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "backgroundColor": "#55101d",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "assets/**/*",
      "**/*.{png,jpg,jpeg,gif,svg,webp,ttf,otf,woff,woff2}"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mg.nyherinnyboky.app"
    },
    "android": {
      "package": "mg.nyherinnyboky.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#55101d"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fdeb06f5-0676-4a98-aa20-a35ac4c5ad8d"
      }
    }
  }
}